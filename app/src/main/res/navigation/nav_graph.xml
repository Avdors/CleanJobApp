<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFirstFragment">

    <!-- LoginFirstFragment -->
    <fragment
        android:id="@+id/loginFirstFragment"
        android:name="com.example.login.presentation.LoginFirstFragment"
        android:label="fragment_login_first"
        tools:layout="@layout/fragment_login_first">
        <deepLink
            app:uri="app://vacancy.com/loginFirstFragment" />
    </fragment>

    <!-- LoginSecondFragment -->
    <fragment
        android:id="@+id/loginSecondFragment"
        android:name="com.example.login.presentation.LoginSecondFragment"
        android:label="fragment_login_second"
        tools:layout="@layout/fragment_login_second">
        <argument
            android:name="email"
            app:argType="string"
             />
        <!-- Deep link для перехода на LoginSecondFragment -->
        <deepLink
            app:uri="app://vacancy.com/loginSecondFragment?email={email}" />
    </fragment>

    <!-- Fragment для списка вакансий -->
    <fragment
        android:id="@+id/listVacanciesFragment"
        android:name="com.example.listvacancy.presentation.ListVacanciesFragment"
        android:label="fragment_list_vacancies"
        tools:layout="@layout/fragment_list_vacancies">
        <deepLink
            app:uri="app://vacancy.com/listVacancies" />

    </fragment>

    <!-- Fragment для избранных вакансий -->
    <fragment
        android:id="@+id/favoriteVacanciesFragment"
        android:name="com.example.favoritevacancy.presentation.FavoriteVacanciesFragment"
        android:label="fragment_favorite_vacancies"
        tools:layout="@layout/fragment_favorite_vacancies">

    </fragment>

    <!-- Заглушка InProgressFragment -->
    <fragment
        android:id="@+id/inProgressFragment"
        android:name="com.example.core.presentation.InProgressFragment"
        android:label="fragment_in_progress"
        tools:layout="@layout/fragment_in_progress">

    </fragment>

    <!-- Fragment для карточки вакансии -->
    <fragment
        android:id="@+id/cardVacancyFragment"
        android:name="com.example.vacancy.presentation.CardVacancyFragment"
        android:label="fragment_card_vacancy"
        tools:layout="@layout/fragment_card_vacancy">
        <argument
            android:name="vacancyId"
            app:argType="string"
            />
        <!-- Аргумент для fromFavorites -->
        <argument
            android:name="fromFavorites"
            app:argType="boolean"
            android:defaultValue="false" /> <!-- По умолчанию false, если не указано -->
        <deepLink
            app:uri="app://vacancy.com/vacancy/{vacancyId}?fromFavorites={fromFavorites}" />
    </fragment>


</navigation>